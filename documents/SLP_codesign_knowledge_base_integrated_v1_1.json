  "activity_generation_rules": {
    "rule_1": {
      "name": "Separate clinical target and activity theme",
      "description": "Select the language or articulation target based on developmental level first, then select the activity theme based on child interests."
    },
    "rule_2": {
      "name": "Combine language and articulation goals when possible",
      "description": "Generate phrases or activities that include both the selected language structure and the selected speech sound target when clinically appropriate."
    },
    "rule_3": {
      "name": "Use developmental level flexibly",
      "description": "Use developmental age, MLU, and SLP judgment rather than chronological age alone."
    },
    "rule_4": {
      "name": "Avoid gender-restricted personalization",
      "description": "Gender-based interest lists are retained from co-design data, but the system should allow any child to use any interest theme."
    }
  },
