          "location_noun",
          "ing_form"
        ]
      },
      {
        "level_id": "language_age_5_mlu_6_8",
        "age": 5,
        "mlu_range": "6-8",
        "targets": [
          "plural_forms",
          "ing_form",
          "pronouns_later",
          "location_noun",
          "simple_conjunction"
        ]
      },
      {
        "level_id": "language_age_6_mlu_8_10",
        "age": 6,
        "mlu_range": "8-10",
        "targets": [
          "plural_forms",
          "ing_form",
          "advanced_conjunction"
        ]
      },
      {
        "level_id": "language_age_8_mlu_11_plus",
        "age": 8,
        "mlu_range": "11+",
        "targets": [
          "irregular_past_tense",
          "advanced_conjunction",
          "auxiliary_verbs",
          "copula_verbs",
          "verb_tense_concepts"
        ]
      }
    ]
  },
  "speech_sound_development_framework": {
    "version": "1.0",
    "description": "Articulation targets organized by approximate developmental age range and difficulty level.",
    "articulation_targets": {
      "early_sounds": {
        "difficulty_level": 1,
        "age_range": "2-3",
        "description": "Early developing consonants for articulation practice.",
        "phonemes": [
          "p",
          "b",
          "m",
          "n",
          "d"
        ],
        "example_words": [
          "pig",
          "ball",
          "mom",
          "nose",
          "dog"
