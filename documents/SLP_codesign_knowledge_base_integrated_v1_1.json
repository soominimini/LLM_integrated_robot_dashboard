      "advanced_sounds": {
        "difficulty_level": 4,
        "age_range": "5+",
        "description": "Late-developing speech sounds for articulation practice.",
        "phonemes": [
          "th",
          "r",
          "ch"
        ],
        "example_words": [
          "thumb",
          "three",
          "rabbit",
          "red",
          "chair",
          "cheese"
        ],
        "example_activity_phrases": [
          "three red cars",
          "rabbit is running",
          "chair under the table"
        ]
