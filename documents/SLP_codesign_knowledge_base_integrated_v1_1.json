        "example_activity_phrases": [
          "big pig",
          "my ball",
          "mommy dog",
          "blue bus"
        ]
      },
      "middle_sounds": {
        "difficulty_level": 2,
        "age_range": "3-4",
        "description": "Middle developing consonants for articulation practice.",
        "phonemes": [
          "k",
          "g",
          "f"
        ],
        "example_words": [
          "cat",
          "go",
          "fish",
          "frog",
